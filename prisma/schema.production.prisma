// Production Prisma schema for PostgreSQL
// This will be used for deployment to Vercel with PostgreSQL database

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  sleepEntries  SleepEntry[]
  clinicalSleepEntries ClinicalSleepEntry[]
  sleepPrograms SleepProgram[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Sleep Diary models
model SleepEntry {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  bedTime      DateTime
  wakeTime     DateTime
  sleepQuality Int      // 1-10 scale
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, date])
  @@index([userId, date])
}

// Stanford Sleep Health Program Compliant Clinical Entry
model ClinicalSleepEntry {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime
  
  // Stanford Q2-Q3: Pre-sleep phase
  timeInBed         DateTime
  preSleepReading   Boolean  @default(false)
  preSleepTV        Boolean  @default(false)
  preSleepOther     String?
  sleepAttemptTime  DateTime
  
  // Stanford Q4-Q6: Sleep onset & maintenance
  sleepLatencyHours Int      @default(0)
  sleepLatencyMins  Int      @default(0)
  nightAwakenings   Int      @default(0)
  awakeningDurHours Int      @default(0)
  awakeningDurMins  Int      @default(0)
  
  // Stanford Q7-Q9: Morning awakening
  earlyAwakening    Boolean  @default(false)
  earlyAwakeHours   Int?
  earlyAwakeMins    Int?
  finalWakeTime     DateTime
  outOfBedTime      DateTime
  
  // Stanford Q10: Sleep totals
  totalSleepHours   Int
  totalSleepMins    Int
  
  // Stanford Q11-Q12: Subjective assessments
  sleepQuality      Int      // 1-5 Stanford scale, displayed as 1-10
  morningRestedness Int      // 1-4 Stanford scale
  
  // Stanford Q13: Previous day factors
  prevDayNapHours   Int      @default(0)
  prevDayNapMins    Int      @default(0)
  
  // Stanford Q1: Medications & substances
  sleepMedications  String?  // JSON string: [{name, dose, timeOfTaken, type}]
  
  // NEW: Subjective wellness metrics (core enhancement)
  morningAlertness  Int?     // 1-10: How alert did you feel upon waking?
  daytimeEnergy     Int?     // 1-10: Rate your overall energy throughout the day
  daytimeFocus      Int?     // 1-10: How was your concentration and focus ability?
  daytimeMood       Int?     // 1-10: Rate your overall mood during the day
  
  // Clinical computed fields
  sleepEfficiency   Float?   // (totalSleep / timeInBed) * 100
  timeInBedDuration Int?     // Minutes between timeInBed and outOfBed
  
  // Stanford Q14: Notes
  comments          String?
  
  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepProgram      SleepProgram? @relation(fields: [sleepProgramId], references: [id], onDelete: SetNull)
  sleepProgramId    String?
  
  // Constraints and indexes
  @@unique([userId, date])
  @@index([userId, date])
  @@index([userId, createdAt])
  @@index([userId, sleepEfficiency])
}

// Two-week Stanford-recommended clinical assessment program
model SleepProgram {
  id              String   @id @default(cuid())
  userId          String
  name            String   // Program display name
  startDate       DateTime
  endDate         DateTime // Target end date (14 days from start)
  completedAt     DateTime? // Actual completion timestamp
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED, DISCONTINUED
  targetDays      Int      @default(14)
  
  // Clinical program details
  instructions    String?  // Stanford clinical instructions
  clinicalGoals   String?  // JSON string of program goals
  notes           String?  // Program notes
  metadata        String?  // JSON metadata for program tracking
  
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries         ClinicalSleepEntry[]
  
  // Indexes for performance
  @@index([userId, startDate])
  @@index([userId, status])
  @@index([startDate, status])
}